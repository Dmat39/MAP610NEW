{
  "name": "map-incidence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@googlemaps/react-wrapper": "^1.2.0",
    "@react-google-maps/api": "^2.20.7",
    "@tanstack/react-query": "^5.90.5",
    "heatmap.js": "^2.0.5",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-heatmap": "^1.0.0",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.10.1",
    "react-spinners": "^0.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.7.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^3.0.2"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix --max-warnings=1000",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
